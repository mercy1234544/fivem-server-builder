# ─────────────────────────────────────────────────────────────────────────────
# Vehicle Studio Auth backend — configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# These secrets live ONLY on the server. They are never sent to the desktop app.
# ─────────────────────────────────────────────────────────────────────────────

# Discord application (discord.com/developers/applications → your app)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# A bot in your server, with the "Server Members Intent" enabled, used to read
# guild membership + roles. (Bot → Token)
DISCORD_BOT_TOKEN=
# Your Discord server (guild) ID.
DISCORD_GUILD_ID=
# Optional: require this role for access. Leave blank to require membership only.
DISCORD_REQUIRED_ROLE_ID=

# Where this backend is reachable (used to build the OAuth redirect URI).
# In Discord → OAuth2 → Redirects, add:  <PUBLIC_BASE_URL>/auth/discord/callback
PUBLIC_BASE_URL=http://localhost:8787

# Secret used to sign/derive session material. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Admin API token (protects /admin/*). Generate a long random value the same way.
ADMIN_TOKEN=

# SQLite database file (a real embedded SQL database). For Postgres later, the
# storage layer is abstracted behind src/db/store.ts.
DATABASE_URL=./data/vehicle-studio-auth.db

# Behaviour
PORT=8787
VERIFICATION_CODE_EXPIRATION=600        # seconds (10 min)
SESSION_TTL=2592000                     # seconds (30 days)
MAX_FAILED_ATTEMPTS=5                    # per IP before temporary lockout
FAILED_ATTEMPT_LOCKOUT=900              # seconds lockout after too many failures
REQUIRE_ROLE=false                      # true = the required role is enforced

# CORS: the desktop app talks to this backend from the Electron main process.
# For a normal web origin you'd list it; the Electron client sends no Origin,
# which is allowed. Add extra allowed origins comma-separated if you need them.
ALLOWED_ORIGINS=
